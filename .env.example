# Copia este archivo como .env y ajusta los valores.
# Las rutas relativas se resuelven desde la raíz del proyecto (no desde la
# carpeta donde se lanza el proceso), así funciona igual desde Claude Desktop.

# Conector activo: csv (por ahora el único; luego canaan360)
CONNECTOR=csv

# Conector CSV/Excel
DATA_DIR=data
# csv o xlsx
FORMATO_DATOS=csv

# Tokens de confirmación (compartidos entre procesos: MCP y el futuro backend web)
CONFIRMACIONES_DB=data/stockmind.db
TOKEN_TTL_MINUTOS=10

# Log de auditoría de escrituras
AUDITORIA_LOG=logs/auditoria.jsonl

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
