# Copia este archivo como .env y ajusta los valores.
# Las rutas relativas se resuelven desde la raíz del proyecto (no desde la
# carpeta donde se lanza el proceso), así funciona igual desde Claude Desktop.

# Conector activo: csv, o el nombre de un conector opcional instalado
CONNECTOR=csv

# Conector CSV/Excel
DATA_DIR=data
# csv o xlsx
FORMATO_DATOS=csv

# Base local de StockMind: tokens de confirmación y bandeja de salida
# (compartida entre procesos: MCP y el futuro backend web)
CONFIRMACIONES_DB=data/stockmind.db
TOKEN_TTL_MINUTOS=10

# Log de auditoría de escrituras
AUDITORIA_LOG=logs/auditoria.jsonl

# Archivos que generan exportar_pendientes y los reportes
EXPORTS_DIR=exports

# Moneda de los productos que no informan una (los reportes no mezclan monedas)
MONEDA_BASE=BOB

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Los conectores opcionales (p. ej. para un ERP real, privado) leen sus propias
# variables de este mismo .env; las documenta cada conector.

# ---------------------------------------------------------------------------
# Servidor MCP en HTTP (stockmind-mcp --http): solo localhost y con token.
# Genera tokens con: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_TOKEN=

# Chat con IA (pip install -e ".[api]")
# anthropic (por defecto claude-sonnet-5-5) | gemini (por defecto gemini-3.8-flash) | falso
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
# Cuánto razona el modelo antes de responder: bajo | medio | alto | apagado (más bajo = más rápido).
# "apagado" usa lo mínimo que permite cada modelo (Gemini 3: minimal o low; Sonnet 5.5: between_tools).
LLM_THINKING=bajo
# Solo Anthropic: reintento del lado del servidor si el modelo rechaza una consulta
LLM_FALLBACKS=true
LLM_MAX_TOKENS=16000
# Saturación (503 en Gemini, 529/overloaded en Anthropic, o sin respuesta en LLM_TIMEOUT_SEGUNDOS):
# el modelo queda "en enfriamiento" LLM_ENFRIAMIENTO_SEGUNDOS y se usa directamente el siguiente de
# LLM_MODELOS_RESPALDO (separados por coma), sin reintentar. Vacío = la lista del proveedor
# (Gemini: gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite; Anthropic: ninguno);
# "ninguno" = sin respaldo. Otros errores temporales (429): con respaldo, 1 reintento a los 2 s;
# sin respaldo, LLM_REINTENTOS reintentos con espera exponencial (2 s, 4 s, 8 s).
LLM_MODELOS_RESPALDO=
LLM_REINTENTOS=3
LLM_ESPERA_INICIAL=2
LLM_ENFRIAMIENTO_SEGUNDOS=300
LLM_TIMEOUT_SEGUNDOS=30

# API del chat (stockmind-api)
API_HOST=127.0.0.1
API_PORT=8000
API_TOKEN=
# Orígenes del frontend, separados por comas (p. ej. http://localhost:5173)
CORS_ORIGINS=
MCP_URL=http://127.0.0.1:8765/mcp
MAX_ITERACIONES_TOOLS=8
MAX_LARGO_MENSAJE=4000
# Menos tokens por llamada (0 = sin límite): turnos de historial que se envían al modelo (los
# anteriores van resumidos) y filas por lista en los resultados de las tools (el panel recibe todo).
HISTORIAL_TURNOS=8
MAX_FILAS_RESULTADO=15

# Opcional: JWT HS256 firmado por el ERP (sub = usuario, exp obligatorio). Mínimo 32 caracteres.
ERP_JWT_SECRETO=
ERP_JWT_EMISOR=
ERP_JWT_AUDIENCIA=
